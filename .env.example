# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Database and cache
DATABASE_URL=postgres://relayops:relayops@localhost:5432/relayops
REDIS_URL=redis://localhost:6379

# Authentication (replace in every non-local environment)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# Provider webhook verification
PROVIDER_WEBHOOK_SECRET=replace-with-a-random-provider-secret
PROVIDER_SIGNATURE_TOLERANCE_SECONDS=300

# Event streaming
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=relayops-control-plane
KAFKA_TOPIC=relayops.domain-events

# Web client (used at build time)
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/live
